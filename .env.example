# SQL Server connection for tools running on the host.
MSSQL_HOST=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=F1_BI
MSSQL_USERNAME=f1_loader
MSSQL_PASSWORD=CHANGE_ME
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_CERTIFICATE=no

# Mage reads the existing dataset directory mounted by compose.yaml.
F1_DATA_DIR=/home/src/dataset
