# Mage in Docker: host.docker.internal for SQL Server on this computer.
# SQL Server on Dung's computer: its reachable DNS/IP, not localhost.
# Host CLI: export MSSQL_HOST=localhost when SQL Server is on this computer.
MSSQL_HOST=host.docker.internal
MSSQL_PORT=1433
MSSQL_DATABASE=F1_BI
MSSQL_USERNAME=f1_loader
MSSQL_PASSWORD=CHANGE_ME
MSSQL_ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_ENCRYPT=yes
MSSQL_TRUST_CERTIFICATE=no

# Host CLI defaults to this repo's dataset/. Optionally set an absolute path.
# F1_DATA_DIR=/absolute/path/to/dataset
# Compose sets /home/src/dataset inside Mage independently.
