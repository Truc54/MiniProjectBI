f1_bi:
  target: dev
  outputs:
    dev:
      type: sqlserver
      driver: "{{ env_var('MSSQL_ODBC_DRIVER', 'ODBC Driver 18 for SQL Server') }}"
      server: "{{ env_var('MSSQL_HOST', 'localhost') }}"
      port: "{{ env_var('MSSQL_PORT', '1433') | int }}"
      database: "{{ env_var('MSSQL_DATABASE', 'F1_BI') }}"
      schema: dw
      user: "{{ env_var('MSSQL_USERNAME', 'f1_loader') }}"
      password: "{{ env_var('MSSQL_PASSWORD') }}"
      encrypt: true
      trust_cert: true
      threads: 4
